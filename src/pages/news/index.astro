---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';
import { getNews } from '../../lib/queries';

const news = await getNews(getDb(Astro.locals), 100);
---
<Base nav="news" title="最新產品" description="YAC 最新上市產品與消息。">
  <nav class="crumb"><a href="/">首頁</a> / <b>最新產品</b></nav>
  <div class="cat-head"><div><h1>最新產品</h1><p>NEW PRODUCTS</p></div></div>
  <div class="news-grid" style="padding:0 var(--pad)">
    {news.map((n) => (
      <a class="card" href={`/news/${n.slug}`}>
        <div class="thumb">{n.cover_image_url && <img src={n.cover_image_url} alt={n.title_zh} loading="lazy" />}</div>
        <div class="cb"><time>{n.published_at.slice(0, 10)}</time><h3>{n.title_zh}</h3>{n.summary && <p>{n.summary}</p>}</div>
      </a>
    ))}
  </div>
  {news.length === 0 && <p class="empty">目前沒有消息</p>}
</Base>
