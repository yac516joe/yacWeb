---
import Base from '../layouts/Base.astro';
---
<Base title="頁面不存在" noindex>
  <div class="notfound">
    <h1>404</h1>
    <p style="margin:12px 0 24px;color:var(--mute)">找不到您要的頁面，可能已移動或網址有誤。</p>
    <div class="cta" style="justify-content:center">
      <a class="btn" href="/catalog">瀏覽產品型錄</a>
      <a class="btn ghost" href="/search">料號 / 車型查詢</a>
    </div>
  </div>
</Base>
