---
import Admin from '../../../layouts/Admin.astro';
import { getDb } from '../../../lib/db';
import { listProducts, pageOptions } from '../../../lib/admin-products';

export const prerender = false;

const db = getDb(Astro.locals);
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const pageId = Number(Astro.url.searchParams.get('page_id')) || 0;
const want = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const [{ rows, total, page, pages }, pagesOpt] = await Promise.all([listProducts(db, { q, pageId: pageId || undefined, page: want }), pageOptions(db)]);
const qs = (p: number) => {
  const u = new URLSearchParams();
  if (q) u.set('q', q);
  if (pageId) u.set('page_id', String(pageId));
  u.set('page', String(p));
  return `?${u}`;
};
const newHref = pageId ? `/admin/products/new?page_id=${pageId}` : '/admin/products/new';
---
<Admin title="產品" active="products">
  <div class="page-h">
    <div><h1>產品</h1><p>共 {total.toLocaleString()} 個料號</p></div>
    <a class="btn" href={newHref}>＋ 新增產品</a>
  </div>
  <div class="card">
    <form class="toolbar" method="get">
      <input name="q" value={q} placeholder="YAC / OEM 料號、車系" />
      <select name="page_id" style="min-width:260px">
        <option value="">全部型錄頁</option>
        {pagesOpt.map((o) => <option value={String(o.value)} selected={o.value === pageId}>{o.label}</option>)}
      </select>
      <button class="btn ghost" type="submit">篩選</button>
      {(q || pageId) && <a href="/admin/products" class="mono" style="font-size:12px">清除</a>}
      <span class="grow"></span>
      {pageId > 0 && <a class="btn ghost sm" href={`/api/admin/import?page=${pageId}`}>匯出此頁 CSV</a>}
    </form>
    <div class="scroll-x">
      <table class="grid">
        <thead><tr><th></th><th>YAC 料號</th><th>型錄頁</th><th>車系</th><th>公開</th><th></th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td style="width:56px">{r.primary_image_url ? <img class="thumb" src={r.primary_image_url} alt="" loading="lazy" /> : null}</td>
              <td class="mono"><b>{r.yac_no}</b></td>
              <td>{r.category_name}／{r.page_title}</td>
              <td>{r.car_series ?? ''}</td>
              <td><span class={`pill ${r.is_published ? 'on' : 'off'}`}>{r.is_published ? '是' : '否'}</span></td>
              <td class="act"><a class="btn ghost sm" href={`/admin/products/${r.id}`}>編輯</a></td>
            </tr>
          ))}
          {!rows.length && <tr><td colspan="6" class="empty">沒有符合的產品</td></tr>}
        </tbody>
      </table>
    </div>
    <div class="pager">
      <span>第 {page}/{pages} 頁</span>
      <span><a class={page <= 1 ? 'dis' : ''} href={qs(page - 1)}>上一頁</a><a class={page >= pages ? 'dis' : ''} href={qs(page + 1)}>下一頁</a></span>
    </div>
  </div>
</Admin>
