---
import Admin from '../../layouts/Admin.astro';
import MediaLibrary from '../../islands/admin/MediaLibrary';
import { all, getDb, getEnv } from '../../lib/db';

export const prerender = false;
const db = getDb(Astro.locals);
const items = await all(db, 'SELECT id, public_url, file_name, mime_type, file_size, created_at FROM media_assets ORDER BY id DESC LIMIT 200');
const enabled = !!getEnv(Astro.locals).MEDIA_BUCKET;
---
<Admin title="圖片庫" active="media">
  <div class="page-h"><div><h1>圖片庫</h1><p>新上傳的圖片存放於 Cloudflare R2；舊產品圖片仍沿用原本路徑</p></div></div>
  {!enabled && <div class="flash warn">尚未綁定 R2 Bucket（MEDIA_BUCKET），暫時無法上傳圖片。</div>}
  <MediaLibrary client:load items={items as any} enabled={enabled} />
</Admin>
