---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';
import { getCategories, getCategoryCovers } from '../../lib/queries';

const db = getDb(Astro.locals);
const [cats, covers] = await Promise.all([getCategories(db), getCategoryCovers(db)]);
---
<Base nav="catalog" title="產品型錄">
  <nav class="crumb"><a href="/">首頁</a> / <b>產品型錄</b></nav>
  <div class="cat-head"><div><h1>產品型錄</h1><p>{cats.length} 大產品線 · 以 YAC / OEM 料號或車型查詢</p></div></div>
  <div class="bento" style="padding:0 var(--pad);grid-auto-rows:130px">
    {cats.map((c, i) => (
      <a class="tile" style="grid-column:span 3" href={`/catalog/${c.slug}`}>
        <span class="no">{String(i + 1).padStart(2, '0')}</span><span class="go">↗</span>
        {covers[c.slug] && <img src={covers[c.slug]} alt="" loading="lazy" style="width:84px;right:12px;bottom:10px" />}
        <div><h3>{c.name_zh}</h3><p>{c.name_en} · {c.product_count} 型號</p></div>
      </a>
    ))}
  </div>
</Base>
<style>
  @media (max-width: 1180px) { .bento :global(.tile) { grid-column: span 6 !important; } }
  @media (max-width: 820px) { .bento :global(.tile) { grid-column: span 2 !important; } }
</style>
