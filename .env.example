# ==============================================================================
# YAC 華佑科技官方網站 (www.yac.com.tw) 環境變數範本 (.env.example)
# ==============================================================================
# 注意：
# 1. 請勿將真實密碼或金鑰提交至 Git 儲存庫！
# 2. 本機開發請將此檔案複製為 `.dev.vars` 並填入測試值。
# 3. 正式環境請透過 Cloudflare Dashboard / `wrangler secret put` / GitHub Secrets 設定。

# --- Cloudflare 部署與資源設定 (供 GitHub Actions / Wrangler CLI 使用) ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
D1_DATABASE_ID=your_d1_database_uuid_here
R2_BUCKET_NAME=yac-website-media
PUBLIC_MEDIA_BASE_URL=https://www.yac.com.tw

# --- 後台管理系統 (Admin CMS) 身分驗證設定 ---
# 驗證模式：可設為 "session" (內建帳密+Session)、"cf_access" (Cloudflare Access) 或 "both"
ADMIN_AUTH_MODE=session

# 內建管理員帳號名稱
ADMIN_USERNAME=admin

# 內建管理員密碼雜湊值（執行 `npm run auth:hash -- "密碼"` 產生，嚴禁填寫明文密碼）
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$replace_with_salt$replace_with_hash

# Session Cookie 簽章金鑰 (請使用 `openssl rand -hex 32` 產生至少 64 字元隨機字串)
SESSION_SECRET=replace_with_at_least_32_bytes_random_hex_secret_key

# --- Cloudflare Access (Zero Trust) 選用設定 (當 ADMIN_AUTH_MODE 為 cf_access 或 both 時使用) ---
CF_ACCESS_TEAM_DOMAIN=https://your-team-name.cloudflareaccess.com
CF_ACCESS_AUD=your_cloudflare_access_application_aud_tag

# --- 詢價單寄信 (Resend，https://resend.com；免費方案每日 100 封) ---
# 未設定時詢價只存入資料庫（後台「詢價單」可查看），不會寄信。
# INQUIRY_FROM_EMAIL 需為已在 Resend 驗證網域的寄件地址，例如 "YAC 網站 <noreply@yac.com.tw>"。
RESEND_API_KEY=re_replace_with_resend_api_key
INQUIRY_FROM_EMAIL=YAC 網站 <noreply@yac.com.tw>
# 收件地址，預設為舊站聯絡信箱 yac106@yac.com.tw
INQUIRY_TO_EMAIL=yac106@yac.com.tw
